# Runtime
APP_ENV=development
PORT=8787
PARTICIPANT_AUTH_MODE=preview
ADMIN_AUTH_MODE=supabase
PARTICIPANT_SESSION_TTL_SECONDS=1800
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Local development authentication
DEV_AUTH_SECRET=replace-with-a-long-random-local-secret

# Supabase (secrets: do not commit real values)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Isolated Supabase project used only by npm run test:db
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# Admin account (only needed when using Supabase admin auth)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Zalo participant authentication (required when PARTICIPANT_AUTH_MODE=zalo)
ZALO_APP_SECRET=
ZALO_GRAPH_BASE_URL=https://graph.zalo.me

# ZBS voucher delivery
ZBS_API_KEY=
ZBS_TEMPLATE_ID=
ZBS_API_BASE_URL=https://zbs.wifim.vn/api

# Delivery worker
WORKER_ID=
DELIVERY_POLL_MS=5000
DELIVERY_BATCH_SIZE=10
DELIVERY_MAX_ATTEMPTS=8

# Google Sheets realtime webhook
# This endpoint is public; add request authentication in Apps Script before production.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbwLHpAjpdyXwgyva0PFkRRHC98a4JFToiCoUZbUgPnzKdS-eGJVmtTJq1TEOOWRitucsA/exec
GOOGLE_SHEETS_WEBHOOK_TIMEOUT_MS=5000
