{
  "name": "lucky-wheels",
  "private": true,
  "version": "1.0.0",
  "description": "Lucky Wheels web app and Zalo Mini App for promotional campaigns.",
  "repository": "",
  "license": "UNLICENSED",
  "browserslist": [
    "Android >= 5",
    "IOS >= 9.3",
    "Edge >= 15",
    "Safari >= 9.1",
    "Chrome >= 49",
    "Firefox >= 31",
    "Samsung >= 5"
  ],
  "scripts": {
    "login:miniapp": "node scripts/zmp.mjs login",
    "start": "vite --mode web",
    "start:miniapp": "node scripts/zmp.mjs start",
    "build": "vite build --mode web",
    "build:miniapp": "vite build --mode miniapp",
    "deploy:miniapp": "node scripts/zmp.mjs deploy",
    "backend:dev": "npm --prefix ../backend run dev",
    "backend:start": "npm --prefix ../backend run start",
    "admin:dev": "npm --prefix ../admin-web run dev",
    "admin:build": "npm --prefix ../admin-web run build",
    "admin:preview": "npm --prefix ../admin-web run preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.27.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "valibot": "^1.2.0",
    "xlsx": "^0.18.5",
    "zmp-sdk": "2.53.0",
    "zmp-ui": "1.11.14"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "sass": "^1.76.0",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.13",
    "vitest": "^4.1.10",
    "zmp-vite-plugin": "1.1.6"
  }
}
